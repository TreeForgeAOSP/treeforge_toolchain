#!/usr/bin/env python3

from __future__ import annotations

import json
import re
import shutil
import subprocess
import os
from collections import defaultdict
from pathlib import Path


SCRIPT_ROOT = Path(
    __file__
).resolve().parents[1]

TOOLCHAIN = Path(
    os.environ.get(
        "TREEFORGE_TOOLCHAIN_ROOT",
        str(SCRIPT_ROOT),
    )
).resolve()

WORKSPACE = TOOLCHAIN.parent

TREEFORGE = Path(
    os.environ.get(
        "TREEFORGE_ROOT",
        str(WORKSPACE / "treeforge"),
    )
).resolve()

TREEFORGE_AOSP = Path(
    os.environ.get(
        "TREEFORGE_AOSP_SOURCE",
        str(TREEFORGE / "aosp"),
    )
).resolve()

KERNEL = Path(
    os.environ.get(
        "TREEFORGE_KERNEL_ROOT",
        str(
            WORKSPACE
            / "kernel"
            / "treeforge_kernel"
        ),
    )
).resolve()


# ============================================================
# OS-managed host commands.
#
# These belong to TreeForge setup / doctor, selected according
# to User / Maintainer / Developer requirements.
# ============================================================

OS_TOOLS = {
    "awk",
    "bash",
    "bc",
    "bison",
    "bzip2",
    "cat",
    "chmod",
    "cmake",
    "cmp",
    "cp",
    "curl",
