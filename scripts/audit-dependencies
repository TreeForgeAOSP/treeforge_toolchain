# ============================================================
# Specialized Android / kernel commands.
#
# If TreeForge or the standalone kernel consumes these, they
# must ultimately be supplied by treeforge_toolchain.
# ============================================================

SPECIALIZED_TOOLS = {
    "adb",
    "adbd",
    "avbtool",
    "build_image",
    "build_super_image",
    "certify_bootimg",
    "create_snapshot",
    "depmod",
    "dtc",
    "e2fsck",
