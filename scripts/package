@dataclass(frozen=True)
class Provider:
    provider_id: str
    platform: str
    source_line: str
    kind: str
    module: str
    source_projects: tuple[str, ...]
    binary_name: str | None = None
    host_binary_name: str | None = None
    comparison_name: str | None = None


