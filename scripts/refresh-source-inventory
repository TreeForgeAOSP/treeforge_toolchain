#!/usr/bin/env python3

from pathlib import Path
import hashlib
import json
import subprocess

ROOT = Path(__file__).resolve().parent.parent
OUTPUT = ROOT / "GITHUB-SOURCE-INVENTORY.json"

result = subprocess.run(
    [
        "git",
        "-C",
        str(ROOT),
        "ls-files",
        "--cached",
        "--others",
        "--exclude-standard",
        "-z",
    ],
    check=True,
    stdout=subprocess.PIPE,
)

records = []

for raw in result.stdout.split(b"\0"):
    if not raw:
        continue

    relative = raw.decode()
    path = ROOT / relative

    if not path.is_file():
        continue

    if path == OUTPUT:
        continue

    digest = hashlib.sha256(path.read_bytes()).hexdigest()

    records.append(
        {
            "path": relative,
            "bytes": path.stat().st_size,
            "sha256": digest,
        }
    )

payload = {
    "schema": 1,
    "purpose": "TreeForge GitHub source/rebuild input inventory",
    "files": sorted(
        records,
        key=lambda item: item["path"],
    ),
}

OUTPUT.write_text(
    json.dumps(payload, indent=2) + "\n"
)

print(f"source_inventory_files={len(records)}")
print(f"source_inventory={OUTPUT}")
