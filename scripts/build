#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="${TREEFORGE_TOOLCHAIN_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}"

RELEASE="android-15.0.0_r36"

HOST_PRODUCT="module_x86_64-trunk_staging-eng"
RUNTIME_PRODUCT="module_arm64-trunk_staging-eng"

TF_SOURCE="$ROOT/work/android-15.0.0_r36-treeforge"
TF_HOST_OUT="$ROOT/out/build/treeforge/linux-x86_64"
TF_RUNTIME_OUT="$ROOT/out/build/treeforge/arm64"

READY_MARKER="$TF_SOURCE/.treeforge-source-ready.json"

JOBS="${TREEFORGE_BUILD_JOBS:-8}"

fail() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage:
  ./scripts/build host
  ./scripts/build runtime
  ./scripts/build host <module>
  ./scripts/build runtime <module>

Examples:
  ./scripts/build host adb
  ./scripts/build host fastboot
  ./scripts/build runtime adbd.treeforge_bootstrap

This command ONLY builds.

It does not:
  - reconstruct source
  - apply patches
  - perform reference builds
  - clean output
  - package providers
  - create releases

To reconstruct the saved TreeForge source modifications:
  ./scripts/prepare-source
EOF
}

build_product() {
    local source_root="$1"
    local out_dir="$2"
    local product="$3"
    shift 3

    (
        cd "$source_root" || exit 1

        export OUT_DIR="$out_dir"

        set +u

        # shellcheck disable=SC1091
        source "$source_root/build/envsetup.sh"

        lunch "$product"

        m -j"$JOBS" "$@"
    )
}

MODE="${1:-}"
TARGET_MODULE="${2:-}"

if [[ "$MODE" == "-h" || "$MODE" == "--help" ]]; then
    usage
    exit 0
fi

if [[ -z "$MODE" ]]; then
    usage
    exit 2
fi

if [[ $# -gt 2 ]]; then
    fail "too many arguments"
fi

case "$MODE" in
    host)
        SELECTED_PRODUCT="$HOST_PRODUCT"
        SELECTED_OUT="$TF_HOST_OUT"

        DEFAULT_MODULES=(
            adb
            fastboot
            avbtool
            mkdtimg
            create_snapshot
            inspect_cow.treeforge
            lpdump
            lpunpack
            simg2img
            mkbootimg
            unpack_bootimg
        )
        ;;
    runtime)
        SELECTED_PRODUCT="$RUNTIME_PRODUCT"
        SELECTED_OUT="$TF_RUNTIME_OUT"

        DEFAULT_MODULES=(
            adbd.treeforge_recovery
            adbd.treeforge_bootstrap
            adbd_system_api_recovery
            fastbootd
            linker.recovery
            snapuserd_ramdisk
            treeforge-vabc-coordinator
        )
        ;;
    *)
        usage
        fail "unknown build mode: $MODE"
        ;;
esac

test -d "$TF_SOURCE" ||
    fail "prepared TreeForge source missing; run ./scripts/prepare-source"

test -f "$READY_MARKER" ||
    fail "prepared-source marker missing; run ./scripts/prepare-source"

test -f "$TF_SOURCE/build/envsetup.sh" ||
    fail "prepared TreeForge source is incomplete"

if [[ -n "$TARGET_MODULE" ]]; then
    BUILD_MODULES=("$TARGET_MODULE")
else
    BUILD_MODULES=("${DEFAULT_MODULES[@]}")
fi

mkdir -p "$SELECTED_OUT"

echo "=== TREEFORGE BUILD ==="
date --iso-8601=seconds
echo
echo "release=$RELEASE"
echo "mode=$MODE"
echo "product=$SELECTED_PRODUCT"
echo "out=$SELECTED_OUT"
echo "target=${TARGET_MODULE:-default-set}"
echo "jobs=$JOBS"
echo
echo "source_preparation=REUSED"
echo "compiled_output=PRESERVED"
echo "build_invocations=1"
echo

build_product \
    "$TF_SOURCE" \
    "$SELECTED_OUT" \
    "$SELECTED_PRODUCT" \
    "${BUILD_MODULES[@]}"

echo
echo "TREEFORGE_BUILD=PASS"
echo "build_mode=$MODE"
echo "build_product=$SELECTED_PRODUCT"
echo "build_target=${TARGET_MODULE:-default-set}"
echo "build_invocations=1"
echo "source_rebuilds=0"
echo "reference_builds=0"
echo "opposite_architecture_builds=0"
echo "DEVICE TOUCHED: NO"
echo "ADB INVOKED: NO"
echo "FASTBOOT INVOKED: NO"
echo "TERMINAL CLOSED: NO"
