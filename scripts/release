#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
DIST = ROOT / "dist"
ASSETS = DIST / "assets"


def execute(
    command: list[str],
    *,
    capture: bool = False,
) -> str:
    completed = subprocess.run(
        command,
        cwd=ROOT,
        text=True,
        stdout=(
            subprocess.PIPE
            if capture
            else None
        ),
        stderr=(
            subprocess.PIPE
            if capture
            else None
        ),
        check=False,
    )

    if completed.returncode != 0:
        detail = ""

        if capture:
            detail = (
                "\n"
                + completed.stdout
                + completed.stderr
            )

        raise SystemExit(
            "ERROR: command failed: "
            + " ".join(command)
            + detail
        )

    return (
        completed.stdout.strip()
        if capture
        else ""
    )


parser = argparse.ArgumentParser()

parser.add_argument(
    "--publish",
    action="store_true",
)

parser.add_argument(
    "--provider",
    action="append",
    default=[],
)

parser.add_argument(
    "--repository",
    help=(
        "GitHub repository that hosts compiled release assets. "
        "This is intentionally separate from the canonical "
        "source repository."
    ),
)

args = parser.parse_args()

verify_command = [
    str(ROOT / "scripts" / "verify"),
]

if args.provider:
    verify_command.append(
        "--allow-partial-dist"
    )

execute(verify_command)

index = json.loads(
    (DIST / "index.json").read_text()
)

records = index["providers"]

source_repository = index["repository"]

release_repository = (
    args.repository
    or os.environ.get(
        "TREEFORGE_RELEASE_REPOSITORY"
    )
)

if args.provider:
    requested = set(args.provider)

    available = {
        record["provider"]
        for record in records
    }

    unknown = requested - available

    if unknown:
        raise SystemExit(
            "ERROR: unknown provider(s): "
            + ", ".join(sorted(unknown))
        )

    records = [
        record
        for record in records
        if record["provider"] in requested
    ]

print(
    f"source_repository={source_repository}"
)

print(
    "release_repository="
    + (
        release_repository
        if release_repository
        else "UNCONFIGURED"
    )
)

print(
    f"provider_count={len(records)}"
)

for record in records:
    print(
        f"{record['provider']}: "
        f"tag={record['release_tag']} "
        f"asset={record['archive']} "
        f"sha256={record['archive_sha256']}"
    )

if not args.publish:
    print("publish=NO")
    print("TREEFORGE RELEASE PLAN: PASS")
    raise SystemExit(0)

if not release_repository:
    raise SystemExit(
        "ERROR: publication repository is not configured; "
        "pass --repository OWNER/REPO or set "
        "TREEFORGE_RELEASE_REPOSITORY"
    )

if shutil.which("gh") is None:
    raise SystemExit(
        "ERROR: gh is required for publication"
    )

status = execute(
    [
        "git",
        "status",
        "--porcelain",
    ],
    capture=True,
)

if status:
    raise SystemExit(
        "ERROR: toolchain worktree must be clean "
        "before publication"
    )

head = execute(
    [
        "git",
        "rev-parse",
        "HEAD",
    ],
    capture=True,
)

if index.get("git_commit") != head:
    raise SystemExit(
        "ERROR: dist was not packaged from HEAD\n"
        f"dist={index.get('git_commit')}\n"
        f"HEAD={head}"
    )

branch = execute(
    [
        "git",
        "branch",
        "--show-current",
    ],
    capture=True,
)

if not branch:
    raise SystemExit(
        "ERROR: detached HEAD cannot publish"
    )

remote_line = execute(
    [
        "git",
        "ls-remote",
        "origin",
        f"refs/heads/{branch}",
    ],
    capture=True,
)

remote_head = (
    remote_line.split()[0]
    if remote_line
    else ""
)

if remote_head != head:
    raise SystemExit(
        "ERROR: origin branch does not match HEAD\n"
        f"branch={branch}\n"
        f"local={head}\n"
        f"remote={remote_head or 'missing'}"
    )

execute(
    [
        "gh",
        "auth",
        "status",
    ]
)

repository = release_repository

# Preflight all tags before creating the first release.
for record in records:
    tag = record["release_tag"]

    existing = subprocess.run(
        [
            "gh",
            "release",
            "view",
            tag,
            "--repo",
            repository,
        ],
        cwd=ROOT,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )

    if existing.returncode == 0:
        raise SystemExit(
            "ERROR: refusing to overwrite "
            f"existing release {tag}"
        )

for record in records:
    provider = record["provider"]
    tag = record["release_tag"]

    archive = (
        ASSETS
        / record["archive"]
    )

    sidecar = archive.with_name(
        archive.name + ".sha256"
    )

    execute(
        [
            "gh",
            "release",
            "create",
            tag,
            str(archive),
            str(sidecar),
            "--repo",
            repository,
            "--target",
            head,
            "--title",
            tag,
            "--notes",
            (
                "TreeForge provider release.\n\n"
                f"Provider: {provider}\n"
                f"Source repository: "
                f"{source_repository}\n"
                f"Android baseline: "
                f"{index['android_release']}\n"
                f"Source commit: {head}\n"
                f"Archive SHA-256: "
                f"{record['archive_sha256']}\n"
            ),
        ]
    )

    print(
        f"{provider}: PUBLISHED {tag}"
    )

print(
    "TREEFORGE RELEASE PUBLICATION: PASS"
)
