#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import tarfile
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
DIST = ROOT / "dist"
ASSETS = DIST / "assets"
PROVIDERS = ROOT / "providers"


def fail(message: str) -> None:
    raise SystemExit(f"ERROR: {message}")


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()

    with path.open("rb") as handle:
        for chunk in iter(
            lambda: handle.read(1024 * 1024),
            b"",
        ):
            digest.update(chunk)

    return digest.hexdigest()


def safe_extract(
    archive: Path,
    destination: Path,
) -> None:
    with tarfile.open(archive, "r:xz") as handle:
        for member in handle.getmembers():
            relative = Path(member.name)

            if (
                relative.is_absolute()
                or ".." in relative.parts
            ):
                fail(
                    f"unsafe archive path: {member.name}"
                )

            if member.islnk():
                fail(
                    f"archive hard link prohibited: {member.name}"
                )

            if member.issym():
                link_target = Path(
                    member.linkname
                )

                if (
                    link_target.is_absolute()
                    or ".." in link_target.parts
                ):
                    fail(
                        "unsafe archive symlink target: "
                        f"{member.name} -> {member.linkname}"
                    )

        handle.extractall(
            destination,
            filter="data",
        )


def verify_payload_symlinks(
    package_root: Path,
) -> None:
    manifest_path = (
        package_root
        / "manifest.json"
    )

    if not manifest_path.is_file():
        fail(
            f"manifest.json missing: {package_root}"
        )

    manifest = json.loads(
        manifest_path.read_text()
    )

    records = manifest.get(
        "payload_files",
        []
    )

    if not isinstance(
        records,
        list,
    ):
        fail(
            "manifest payload_files must be a list"
        )

    payload_root = (
        package_root
        / "payload"
    )

    if not payload_root.is_dir():
        fail(
            f"payload directory missing: {package_root}"
        )

    declared: dict[str, str] = {}

    for record in records:
        if not isinstance(
            record,
            dict,
        ):
            fail(
                "manifest payload record is not an object"
            )

        if record.get(
            "kind"
        ) != "symlink":
            continue

        relative_text = record.get(
            "path"
        )

        target_text = record.get(
            "target"
        )

        if (
            not isinstance(
                relative_text,
                str,
            )
            or not relative_text
        ):
            fail(
                "manifest symlink has invalid path"
            )

        if (
            not isinstance(
                target_text,
                str,
            )
            or not target_text
        ):
            fail(
                "manifest symlink has invalid target: "
                f"{relative_text}"
            )

        relative = Path(
            relative_text
        )

        target = Path(
            target_text
        )

        if (
            relative.is_absolute()
            or ".." in relative.parts
        ):
            fail(
                "unsafe manifest symlink path: "
                f"{relative_text}"
            )

        if (
            target.is_absolute()
            or ".." in target.parts
        ):
            fail(
                "unsafe manifest symlink target: "
                f"{relative_text} -> {target_text}"
            )

        if relative_text in declared:
            fail(
                "duplicate manifest symlink path: "
                f"{relative_text}"
            )

        declared[
            relative_text
        ] = target_text

    actual: dict[str, str] = {}

    for candidate in payload_root.rglob(
        "*"
    ):
        if not candidate.is_symlink():
            continue

        relative_text = str(
            candidate.relative_to(
                payload_root
            )
        )

        target_text = str(
            candidate.readlink()
        )

        actual[
            relative_text
        ] = target_text

    declared_paths = set(
        declared
    )

    actual_paths = set(
        actual
    )

    if actual_paths != declared_paths:
        fail(
            "payload symlink set differs from manifest\n"
            f"declared={sorted(declared_paths)}\n"
            f"actual={sorted(actual_paths)}"
        )

    payload_resolved = (
        payload_root.resolve()
    )

    for relative_text in sorted(
        declared
    ):
        expected_target = declared[
            relative_text
        ]

        actual_target = actual[
            relative_text
        ]

        if actual_target != expected_target:
            fail(
                "payload symlink target mismatch: "
                f"{relative_text}\n"
                f"expected={expected_target}\n"
                f"actual={actual_target}"
            )

        symlink_path = (
            payload_root
            / relative_text
        )

        if not symlink_path.is_symlink():
            fail(
                "manifest-declared symlink missing: "
                f"{relative_text}"
            )

        try:
            resolved = (
                symlink_path.resolve(
                    strict=True
                )
            )
        except FileNotFoundError:
            fail(
                "payload symlink target missing: "
                f"{relative_text} -> {actual_target}"
            )

        try:
            resolved.relative_to(
                payload_resolved
            )
        except ValueError:
            fail(
                "payload symlink escapes payload root: "
                f"{relative_text} -> {actual_target}"
            )

        if not resolved.is_file():
            fail(
                "payload symlink does not resolve "
                "to a regular file: "
                f"{relative_text} -> {actual_target}"
            )


def verify_internal_sha256(
    package_root: Path,
) -> None:
    verify_payload_symlinks(
        package_root
    )

    ledger = package_root / "SHA256SUMS"

    if not ledger.is_file():
        fail(
            f"internal SHA256SUMS missing: {package_root}"
        )

    seen: set[str] = set()

    for line in ledger.read_text().splitlines():
        if not line.strip():
            continue

        try:
            expected, relative_text = line.split(
                "  ",
                1,
            )
        except ValueError:
            fail(
                f"invalid internal checksum line: {line!r}"
            )

        if relative_text in seen:
            fail(
                f"duplicate checksum path: {relative_text}"
            )

        seen.add(relative_text)

        relative = Path(relative_text)

        if (
            relative.is_absolute()
            or ".." in relative.parts
        ):
            fail(
                f"unsafe checksum path: {relative_text}"
            )

        target = package_root / relative

        if not target.is_file():
            fail(
                f"checksummed file missing: {relative_text}"
            )

        actual = sha256_file(target)

        if actual != expected:
            fail(
                f"internal SHA mismatch: {relative_text}\n"
                f"expected={expected}\n"
                f"actual={actual}"
            )


def payload_hash_map(
    package_root: Path,
) -> dict[str, list[Path]]:
    result: dict[str, list[Path]] = {}
    payload = package_root / "payload"

    if not payload.is_dir():
        return result

    for path in payload.rglob("*"):
        if not path.is_file():
            continue

        result.setdefault(
            sha256_file(path),
            [],
        ).append(path)

    return result


def is_consumer_manifest_data(
    *,
    data: dict,
    provider: str,
    release: str,
) -> bool:
    if (
        data.get("name") != provider
        or data.get("release") != release
    ):
        return False

    schema = data.get("schema")

    if schema == 2:
        return True

    if schema != 1:
        return False

    if not isinstance(
        data.get("canonical_sdk_level"),
        str,
    ) or not data["canonical_sdk_level"]:
        return False

    if not isinstance(
        data.get("architecture"),
        str,
    ) or not data["architecture"]:
        return False

    files = data.get("files")

    if not isinstance(files, list) or not files:
        return False

    for record in files:
        if not isinstance(record, dict):
            return False

        relative = record.get("path")
        digest = record.get("sha256")

        if (
            not isinstance(relative, str)
            or not relative
            or not isinstance(digest, str)
            or len(digest) != 64
            or digest.lower() != digest
            or any(
                char not in "0123456789abcdef"
                for char in digest
            )
        ):
            return False

        relative_path = Path(relative)

        if (
            relative_path.is_absolute()
            or ".." in relative_path.parts
        ):
            return False

    return True


def verify_consumer_manifest(
    *,
    provider: str,
    release: str,
    package_root: Path,
    source_manifest: Path,
) -> None:
    packaged = (
        package_root
        / "consumer"
        / "manifest.json"
    )

    if not packaged.is_file():
        fail(
            f"{provider}: consumer/manifest.json missing"
        )

    if packaged.read_bytes() != source_manifest.read_bytes():
        fail(
            f"{provider}: packaged consumer manifest "
            "differs from source"
        )

    data = json.loads(packaged.read_text())

    if data.get("schema") == 1:
        if not is_consumer_manifest_data(
            data=data,
            provider=provider,
            release=release,
        ):
            fail(
                f"{provider}: invalid schema-1 "
                "runtime consumer manifest"
            )

        payload_root = package_root / "payload"

        if not payload_root.is_dir():
            fail(
                f"{provider}: runtime consumer "
                "package has no payload directory"
            )

        payload_by_sha: dict[str, list[Path]] = {}

        for payload_file in sorted(
            path
            for path in payload_root.rglob("*")
            if path.is_file()
        ):
            digest = sha256_file(payload_file)

            payload_by_sha.setdefault(
                digest,
                [],
            ).append(payload_file)

        for record in data["files"]:
            expected = record["sha256"]

            if expected not in payload_by_sha:
                fail(
                    f"{provider}: runtime consumer payload "
                    "does not contain manifest SHA-256 "
                    f"{expected} for {record['path']}"
                )

        return


    if data.get("schema") != 2:
        fail(
            f"{provider}: consumer schema is not 2"
        )

    if data.get("name") != provider:
        fail(
            f"{provider}: consumer name mismatch"
        )

    if data.get("release") != release:
        fail(
            f"{provider}: consumer release mismatch"
        )

    payload_hashes = payload_hash_map(
        package_root
    )

    for section in (
        "executables",
        "runtime_files",
    ):
        for record in data.get(section, []):
            relative = Path(record["path"])
            expected = record["sha256"]

            direct = (
                package_root
                / "payload"
                / relative
            )

            if (
                direct.is_file()
                and sha256_file(direct) == expected
            ):
                continue

            matches = payload_hashes.get(
                expected,
                [],
            )

            if len(matches) != 1:
                fail(
                    f"{provider}: cannot uniquely map "
                    f"{section} {relative}; "
                    f"matches={len(matches)}"
                )

    for section in (
        "legal_files",
        "provenance_files",
    ):
        for record in data.get(section, []):
            relative = Path(record["path"])

            if (
                relative.is_absolute()
                or ".." in relative.parts
            ):
                fail(
                    f"{provider}: unsafe normalized path "
                    f"{relative}"
                )

            target = package_root / relative

            if not target.is_file():
                fail(
                    f"{provider}: normalized file missing "
                    f"{relative}"
                )

            if sha256_file(target) != record["sha256"]:
                fail(
                    f"{provider}: normalized SHA mismatch "
                    f"{relative}"
                )


parser = argparse.ArgumentParser()

parser.add_argument(
    "--allow-partial-dist",
    action="store_true",
    help=(
        "Allow dist/index.json to contain a verified subset "
        "of the source provider catalog."
    ),
)

args = parser.parse_args()

index_path = DIST / "index.json"

if not index_path.is_file():
    fail(
        "dist/index.json missing; run scripts/package first"
    )

index = json.loads(
    index_path.read_text()
)

records = index.get("providers")

if not isinstance(records, list):
    fail(
        "dist providers must be a list"
    )

if index.get("provider_count") != len(records):
    fail(
        "dist provider_count mismatch"
    )

names = [
    record["provider"]
    for record in records
]

if len(names) != len(set(names)):
    fail(
        "duplicate provider identity in dist"
    )

tags = [
    record["release_tag"]
    for record in records
]

if len(tags) != len(set(tags)):
    fail(
        "duplicate release tag in dist"
    )

source_index = json.loads(
    (
        PROVIDERS
        / "index.json"
    ).read_text()
)

source_names = set(
    source_index["providers"]
)

dist_names = set(names)

if args.allow_partial_dist:
    unknown_dist_names = (
        dist_names - source_names
    )

    if unknown_dist_names:
        fail(
            "dist contains provider(s) absent from source catalog\n"
            f"unknown={sorted(unknown_dist_names)}"
        )
else:
    if source_names != dist_names:
        fail(
            "source catalog differs from dist provider set\n"
            f"source={sorted(source_names)}\n"
            f"dist={sorted(dist_names)}"
        )

expected_assets: set[str] = set()
consumer_count = 0

for number, record in enumerate(
    records,
    start=1,
):
    provider = record["provider"]
    release = (
        index["android_release"]
        + "-"
        + record["platform"]
    )

    archive = (
        ASSETS
        / record["archive"]
    )

    sidecar = archive.with_name(
        archive.name + ".sha256"
    )

    expected_assets.add(
        archive.name
    )
    expected_assets.add(
        sidecar.name
    )

    if not archive.is_file():
        fail(
            f"{provider}: archive missing"
        )

    if not sidecar.is_file():
        fail(
            f"{provider}: sidecar missing"
        )

    archive_sha = sha256_file(
        archive
    )

    if archive_sha != record["archive_sha256"]:
        fail(
            f"{provider}: archive SHA mismatch"
        )

    expected_sidecar = (
        f"{archive_sha}  {archive.name}"
    )

    if sidecar.read_text().strip() != expected_sidecar:
        fail(
            f"{provider}: sidecar mismatch"
        )

    with tempfile.TemporaryDirectory(
        prefix="treeforge-provider-verify-"
    ) as raw:
        temporary = Path(raw)

        safe_extract(
            archive,
            temporary,
        )

        package_root = (
            temporary
            / f"{provider}-{release}"
        )

        if not package_root.is_dir():
            fail(
                f"{provider}: package root missing"
            )

        verify_internal_sha256(
            package_root
        )

        release_json = (
            package_root
            / "RELEASE.json"
        )

        source_rebuild = (
            package_root
            / "SOURCE-REBUILD.json"
        )

        release_manifest = (
            package_root
            / "manifest.json"
        )

        for required in (
            release_json,
            source_rebuild,
            release_manifest,
        ):
            if not required.is_file():
                fail(
                    f"{provider}: missing {required.name}"
                )

        release_data = json.loads(
            release_json.read_text()
        )

        if release_data.get("provider") != provider:
            fail(
                f"{provider}: RELEASE provider mismatch"
            )

        if (
            release_data.get("release_tag")
            != record["release_tag"]
        ):
            fail(
                f"{provider}: RELEASE tag mismatch"
            )

        if (
            release_data.get("repository")
            != index["repository"]
        ):
            fail(
                f"{provider}: repository mismatch"
            )

        rebuild_data = json.loads(
            source_rebuild.read_text()
        )

        if rebuild_data.get("provider") != provider:
            fail(
                f"{provider}: SOURCE-REBUILD identity mismatch"
            )

        source_manifest = (
            PROVIDERS
            / provider
            / release
            / "manifest.json"
        )

        if not source_manifest.is_file():
            fail(
                f"{provider}: source manifest missing"
            )

        source_data = json.loads(
            source_manifest.read_text()
        )

        expected_consumer = (
            is_consumer_manifest_data(data=source_data, provider=provider, release=release)
        )

        actual_consumer = bool(
            record.get(
                "consumer_manifest",
                False,
            )
        )

        if actual_consumer != expected_consumer:
            fail(
                f"{provider}: consumer flag disagrees "
                "with source manifest schema"
            )

        if expected_consumer:
            verify_consumer_manifest(
                provider=provider,
                release=release,
                package_root=package_root,
                source_manifest=source_manifest,
            )

            consumer_count += 1
        else:
            unexpected = (
                package_root
                / "consumer"
                / "manifest.json"
            )

            if unexpected.exists():
                fail(
                    f"{provider}: schema-1 provider "
                    "contains unexpected consumer manifest"
                )

    print(
        f"[{number:02}/{len(records):02}] "
        f"{provider}: PASS {archive_sha}"
    )


actual_assets = {
    path.name
    for path in ASSETS.iterdir()
    if path.is_file()
}

if actual_assets != expected_assets:
    fail(
        "dist/assets does not match provider index\n"
        f"extra={sorted(actual_assets - expected_assets)}\n"
        f"missing={sorted(expected_assets - actual_assets)}"
    )


combined_path = DIST / "SHA256SUMS"

if not combined_path.is_file():
    fail(
        "dist/SHA256SUMS missing"
    )

combined: dict[str, str] = {}

for line in combined_path.read_text().splitlines():
    if not line.strip():
        continue

    digest, archive_name = line.split(
        "  ",
        1,
    )

    if archive_name in combined:
        fail(
            f"duplicate combined checksum: {archive_name}"
        )

    combined[archive_name] = digest

if len(combined) != len(records):
    fail(
        "combined SHA256SUMS count mismatch"
    )

for record in records:
    if (
        combined.get(record["archive"])
        != record["archive_sha256"]
    ):
        fail(
            f"combined checksum mismatch: "
            f"{record['archive']}"
        )


print()
print(
    f"provider_count={len(records)}"
)
print(
    f"consumer_manifest_count={consumer_count}"
)
print("archive_sha256=PASS")
print("archive_sidecars=PASS")
print("internal_sha256=PASS")
print("release_identity=PASS")
print("source_rebuild_identity=PASS")
print("normalized_consumers=PASS")
print("provider_catalog=PASS")
print("asset_set_exact=PASS")
print("TREEFORGE TOOLCHAIN VERIFY: PASS")
