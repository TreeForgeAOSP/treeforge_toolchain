+    if (fd < 0) {
+        fprintf(stdout,
+                "\nServer:\n"
+                "  reachable: no\n"
+                "  variant: unavailable\n"
+                "  identity: unavailable\n"
+                "  error: %s\n",
+                error.c_str());
