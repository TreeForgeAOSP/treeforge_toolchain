+// TreeForge presentation of AOSP's existing host:server-status reply.
+// No TreeForge-specific protobuf field or ADB protocol version is added.
+class TreeForgeServerInfoStreamsCallback
+    : public DefaultStandardStreamsCallback {
+  public:
+    explicit TreeForgeServerInfoStreamsCallback(
+            bool identity_verified)
+        : DefaultStandardStreamsCallback(nullptr, nullptr),
+          identity_verified_(identity_verified) {}
+
+    bool OnStdout(
+            const char* buffer,
+            size_t length) override {
+        return OnStream(
+            &output_,
+            nullptr,
+            buffer,
+            length,
+            false
+        );
+    }
+
+    int Done(int status) {
+        fprintf(stdout,
+                "\nServer:\n"
+                "  reachable: yes\n"
+                "  variant: %s\n"
+                "  identity: %s\n",
+                identity_verified_
+                        ? "treeforge"
+                        : "unverified",
+                identity_verified_
+                        ? "verified"
+                        : "unverified");
+
+        if (output_.size() < 4) {
+            fprintf(stdout,
+                    "  metadata: unavailable\n");
+            return status;
+        }
+
+        /*
+         * AOSP host replies prefix the serialized protobuf with
+         * four hexadecimal length bytes.
+         */
+        std::string binary_proto_bytes{
+                output_.substr(4)};
+
+        ::adb::proto::AdbServerStatus server;
+
+        if (!server.ParseFromString(
+                binary_proto_bytes)) {
+            fprintf(stdout,
+                    "  metadata: malformed\n");
+            return status;
+        }
+
+        fprintf(stdout,
+                "  version: %s\n"
+                "  build: %s\n"
+                "  executable: %s\n"
+                "  log: %s\n"
+                "  os: %s\n"
+                "  usb_backend: %s%s\n"
+                "  mdns_backend: %s%s\n",
+                server.version().c_str(),
+                server.build().c_str(),
+                server.executable_absolute_path().c_str(),
+                server.log_absolute_path().c_str(),
+                server.os().c_str(),
+                treeforge_usb_backend_name(
+                        server.usb_backend()),
+                server.usb_backend_forced()
+                        ? " (forced)"
+                        : "",
+                treeforge_mdns_backend_name(
+                        server.mdns_backend()),
+                server.mdns_backend_forced()
+                        ? " (forced)"
+                        : "");
+
+        return status;
+    }
+
+  private:
+    bool identity_verified_;
+    std::string output_;
+
+    DISALLOW_COPY_AND_ASSIGN(
+            TreeForgeServerInfoStreamsCallback);
+};
