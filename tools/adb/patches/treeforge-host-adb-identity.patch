+static std::string treeforge_device_enum_name(
+        const ::adb::proto::Device& device,
+        const char* field_name) {
+    const auto* descriptor = device.GetDescriptor();
+
+    if (descriptor == nullptr) {
+        return "UNKNOWN";
+    }
+
+    const auto* field = descriptor->FindFieldByName(field_name);
+
+    if (field == nullptr) {
+        return "UNKNOWN";
+    }
+
+    const auto* reflection = device.GetReflection();
+
+    if (reflection == nullptr) {
+        return "UNKNOWN";
+    }
+
+    const auto* value = reflection->GetEnum(device, field);
+
+    if (value == nullptr) {
+        return "UNKNOWN";
+    }
+
+    return value->name();
+}
+
+
+static const char* treeforge_value_or_unknown(
+        const std::string& value) {
+    return value.empty() ? "<unknown>" : value.c_str();
+}
+
+
+static bool treeforge_transport_state_ready(
+        ::adb::proto::ConnectionState state) {
+    switch (state) {
+        case ::adb::proto::ConnectionState::BOOTLOADER:
+        case ::adb::proto::ConnectionState::DEVICE:
+        case ::adb::proto::ConnectionState::HOST:
+        case ::adb::proto::ConnectionState::RECOVERY:
+        case ::adb::proto::ConnectionState::SIDELOAD:
+        case ::adb::proto::ConnectionState::RESCUE:
+            return true;
+
+        default:
+            return false;
+    }
+}
+
+
+static const char* treeforge_selector_name(
+        TransportType transport_type,
+        const char* serial,
+        TransportId transport_id) {
+    if (transport_id != 0) {
+        return "transport-id";
+    }
+
+    if (serial != nullptr) {
+        return "serial";
+    }
+
+    if (transport_type == kTransportUsb) {
+        return "usb";
+    }
+
+    if (transport_type == kTransportLocal) {
+        return "socket";
+    }
+
+    return "any";
+}
+
+
+static const char* treeforge_selection_error_status(
+        const std::string& error) {
+    if (error.find("more than one") != std::string::npos) {
+        return "ambiguous";
+    }
+
+    if (error.find("unauthorized") != std::string::npos) {
+        return "unauthorized";
+    }
+
+    if (error.find("authorizing") != std::string::npos) {
+        return "authorizing";
+    }
+
+    if (error.find("connecting") != std::string::npos) {
+        return "connecting";
+    }
+
+    if (error.find("offline") != std::string::npos) {
+        return "offline";
+    }
+
+    if (
+        error.find("permission") != std::string::npos
+        || error.find("Permission") != std::string::npos
+    ) {
+        return "no-permission";
+    }
+
+    if (
+        error.find("not found") != std::string::npos
+        || error.find("no device") != std::string::npos
+        || error.find("no emulator") != std::string::npos
+    ) {
+        return "not-found";
+    }
+
+    return "error";
+}
