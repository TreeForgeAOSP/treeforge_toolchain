+static bool treeforge_query_server_identity() {
+    std::string result;
+    std::string error;
+
+    if (!adb_query(
+            "host:host-features",
+            &result,
+            &error)) {
+        return false;
+    }
+
+    const FeatureSet features =
+            StringToFeatureSet(result);
+
+    for (const std::string& feature : features) {
+        if (feature == kTreeForgeHostIdentityFeature) {
+            return true;
+        }
+    }
+
+    return false;
+}
