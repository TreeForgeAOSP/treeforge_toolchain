+static void treeforge_print_transport_info(
+        TransportType transport_type,
+        const char* serial,
+        TransportId transport_id) {
+    std::string error;
+
+    /*
+     * Reuse AOSP's existing structured device-tracker service.
+     *
+     * We deliberately request only the first snapshot. Closing the
+     * returned fd unregisters this client from further tracking.
+     */
+    unique_fd fd(
+        adb_connect(
+            nullptr,
+            "host:track-devices-proto-binary",
+            &error
+        )
+    );
+
+    if (fd < 0) {
+        fprintf(stdout,
+                "\nTransports:\n"
+                "  available: no\n"
+                "  error: %s\n",
+                error.c_str());
+        return;
+    }
+
+    char length_hex[5] = {};
+
+    if (!treeforge_read_exact(
+            fd.get(),
+            length_hex,
+            4)) {
+        fprintf(stdout,
+                "\nTransports:\n"
+                "  available: no\n"
+                "  error: failed to read snapshot length\n");
+        return;
+    }
+
+    unsigned int payload_length = 0;
+
+    if (sscanf(
+            length_hex,
+            "%4x",
+            &payload_length) != 1) {
+        fprintf(stdout,
+                "\nTransports:\n"
+                "  available: no\n"
+                "  error: malformed snapshot length\n");
+        return;
+    }
+
+    static constexpr unsigned int
+        kTreeForgeMaximumTransportSnapshot =
+            16 * 1024 * 1024;
+
+    if (payload_length >
+        kTreeForgeMaximumTransportSnapshot) {
+        fprintf(stdout,
+                "\nTransports:\n"
+                "  available: no\n"
+                "  error: snapshot exceeds safety limit\n");
+        return;
+    }
+
+    std::string payload(
+        payload_length,
+        '\0'
+    );
+
+    if (
+        payload_length != 0
+        && !treeforge_read_exact(
+            fd.get(),
+            payload.data(),
+            payload.size()
+        )
+    ) {
+        fprintf(stdout,
+                "\nTransports:\n"
+                "  available: no\n"
+                "  error: failed to read snapshot payload\n");
+        return;
+    }
+
+    ::adb::proto::Devices devices;
+
+    if (!devices.ParseFromString(payload)) {
+        fprintf(stdout,
+                "\nTransports:\n"
+                "  available: no\n"
+                "  error: malformed Devices protobuf\n");
+        return;
+    }
+
+    fprintf(stdout,
+            "\nTransports:\n"
+            "  available: yes\n"
+            "  count: %d\n",
+            devices.device_size());
+
+    int index = 0;
+
+    for (const auto& device : devices.device()) {
+        ++index;
+
+        const std::string state =
+            treeforge_device_enum_name(
+                device,
+                "state"
+            );
+
+        const std::string connection =
+            treeforge_device_enum_name(
+                device,
+                "connection_type"
+            );
+
+        fprintf(stdout,
+                "\n"
+                "  [%d]\n"
+                "    serial: %s\n"
+                "    state: %s\n"
+                "    connection: %s\n"
+                "    bus_address: %s\n"
+                "    product: %s\n"
+                "    model: %s\n"
+                "    device: %s\n"
+                "    negotiated_speed_mbps: %lld\n"
+                "    max_speed_mbps: %lld\n"
+                "    transport_id: %lld\n",
+                index,
+                treeforge_value_or_unknown(
+                    device.serial()
+                ),
+                state.c_str(),
+                connection.c_str(),
+                treeforge_value_or_unknown(
+                    device.bus_address()
+                ),
+                treeforge_value_or_unknown(
+                    device.product()
+                ),
+                treeforge_value_or_unknown(
+                    device.model()
+                ),
+                treeforge_value_or_unknown(
+                    device.device()
+                ),
+                static_cast<long long>(
+                    device.negotiated_speed()
+                ),
+                static_cast<long long>(
+                    device.max_speed()
+                ),
+                static_cast<long long>(
+                    device.transport_id()
+                ));
+    }
+
+    int ready = 0;
+    int connecting = 0;
+    int authorizing = 0;
+    int unauthorized = 0;
+    int no_permission = 0;
+    int detached = 0;
+    int offline = 0;
+    int bootloader = 0;
+    int android_device = 0;
+    int host = 0;
+    int recovery = 0;
+    int sideload = 0;
+    int rescue = 0;
+    int any = 0;
+    int unknown = 0;
+
+    for (const auto& device : devices.device()) {
+        if (treeforge_transport_state_ready(device.state())) {
+            ++ready;
+        }
+
+        switch (device.state()) {
+            case ::adb::proto::ConnectionState::ANY:
+                ++any;
+                break;
+
+            case ::adb::proto::ConnectionState::CONNECTING:
+                ++connecting;
+                break;
+
+            case ::adb::proto::ConnectionState::AUTHORIZING:
+                ++authorizing;
+                break;
+
+            case ::adb::proto::ConnectionState::UNAUTHORIZED:
+                ++unauthorized;
+                break;
+
+            case ::adb::proto::ConnectionState::NOPERMISSION:
+                ++no_permission;
+                break;
+
+            case ::adb::proto::ConnectionState::DETACHED:
+                ++detached;
+                break;
+
+            case ::adb::proto::ConnectionState::OFFLINE:
+                ++offline;
+                break;
+
+            case ::adb::proto::ConnectionState::BOOTLOADER:
+                ++bootloader;
+                break;
+
+            case ::adb::proto::ConnectionState::DEVICE:
+                ++android_device;
+                break;
+
+            case ::adb::proto::ConnectionState::HOST:
+                ++host;
+                break;
+
+            case ::adb::proto::ConnectionState::RECOVERY:
+                ++recovery;
+                break;
+
+            case ::adb::proto::ConnectionState::SIDELOAD:
+                ++sideload;
+                break;
+
+            case ::adb::proto::ConnectionState::RESCUE:
+                ++rescue;
+                break;
+
+            default:
+                ++unknown;
+                break;
+        }
+    }
+
+    fprintf(stdout,
+            "\nHealth:\n"
+            "  ready: %d\n"
+            "  connecting: %d\n"
+            "  authorizing: %d\n"
+            "  unauthorized: %d\n"
+            "  no_permission: %d\n"
+            "  detached: %d\n"
+            "  offline: %d\n"
+            "  bootloader: %d\n"
+            "  device: %d\n"
+            "  host: %d\n"
+            "  recovery: %d\n"
+            "  sideload: %d\n"
+            "  rescue: %d\n"
+            "  any: %d\n"
+            "  unknown: %d\n",
+            ready,
+            connecting,
+            authorizing,
+            unauthorized,
+            no_permission,
+            detached,
+            offline,
+            bootloader,
+            android_device,
+            host,
+            recovery,
+            sideload,
+            rescue,
+            any,
+            unknown);
+
+    fprintf(stdout,
+            "\nSelection:\n"
+            "  selector: %s\n",
+            treeforge_selector_name(
+                transport_type,
+                serial,
+                transport_id
+            ));
+
+    if (serial != nullptr) {
+        fprintf(stdout,
+                "  requested_serial: %s\n",
+                serial);
+    }
+
+    if (transport_id != 0) {
+        fprintf(stdout,
+                "  requested_transport_id: %llu\n",
+                static_cast<unsigned long long>(
+                    transport_id
+                ));
+    }
+
+    /*
+     * Ask AOSP's own transport resolver which transport the current
+     * -s/-t/-d/-e/ANDROID_SERIAL selection resolves to.
+     *
+     * This is the same mechanism used by the stock "transport-id"
+     * command. It avoids reimplementing MatchesTarget(), ambiguity
+     * rules, connection-state rejection, or selector precedence.
+     */
+    TransportId resolved_transport_id = 0;
+    std::string selection_error;
+
+    unique_fd selection_fd(
+        adb_connect(
+            &resolved_transport_id,
+            "host:features",
+            &selection_error,
+            true
+        )
+    );
+
+    if (selection_fd < 0) {
+        fprintf(stdout,
+                "  status: %s\n"
+                "  error: %s\n",
+                treeforge_selection_error_status(
+                    selection_error
+                ),
+                selection_error.c_str());
+
+        return;
+    }
+
+    fprintf(stdout,
+            "  status: resolved\n"
+            "  transport_id: %llu\n",
+            static_cast<unsigned long long>(
+                resolved_transport_id
+            ));
+
+    const ::adb::proto::Device* selected = nullptr;
+
+    for (const auto& device : devices.device()) {
+        if (
+            static_cast<TransportId>(
+                device.transport_id()
+            ) == resolved_transport_id
+        ) {
+            selected = &device;
+            break;
+        }
+    }
+
+    if (selected == nullptr) {
+        /*
+         * The transport set can legitimately change between our
+         * snapshot and AOSP's selector resolution.
+         */
+        fprintf(stdout,
+                "  snapshot_match: no\n");
+        return;
+    }
+
+    fprintf(stdout,
+            "  snapshot_match: yes\n"
+            "  serial: %s\n"
+            "  state: %s\n"
+            "  connection: %s\n",
+            treeforge_value_or_unknown(
+                selected->serial()
+            ),
+            treeforge_device_enum_name(
+                *selected,
+                "state"
+            ).c_str(),
+            treeforge_device_enum_name(
+                *selected,
+                "connection_type"
+            ).c_str());
+}
