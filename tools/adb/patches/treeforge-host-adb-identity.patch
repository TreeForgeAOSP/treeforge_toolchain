+/*
+ * Read exactly one adb service frame.
+ *
+ * The existing AOSP track-devices protobuf service emits:
+ *
+ *     4 ASCII hexadecimal length bytes
+ *     serialized adb::proto::Devices payload
+ *
+ * We consume only the initial snapshot and then close the client-side
+ * connection. No new host service or wire format is introduced.
+ */
+static bool treeforge_read_exact(
+        int fd,
+        void* buffer,
+        size_t length) {
+    char* cursor = static_cast<char*>(buffer);
+
+    while (length > 0) {
+        int rc = adb_read(fd, cursor, length);
+
+        if (rc <= 0) {
+            return false;
+        }
+
+        cursor += rc;
+        length -= rc;
+    }
+
+    return true;
+}
